+// SPIKE (cef-spike.md): the existing surface path is a *video* path — two
+// planes, YCbCr, written for livekit. A browser hands over a single BGRA
+// IOSurface, so it needs its own fragment function. Everything else about
+// the surface primitive (vertex stage, clipping, ordering) is unchanged,
+// which is the point: the page becomes an ordinary scene primitive.
+fragment float4 surface_bgra_fragment(SurfaceFragmentInput input [[stage_in]],
+                                      texture2d<float> bgra_texture
+                                      [[texture(SurfaceInputIndex_YTexture)]]) {
+  constexpr sampler texture_sampler(mag_filter::linear, min_filter::linear);
+  return bgra_texture.sample(texture_sampler, input.texture_position);
+}
