# The CEF pin. Sourced by scripts/mac-bundle.sh; read by CI to key its cache.
#
# WHY A FILE AND NOT A CARGO CONSTRAINT: the Rust crate and the binary
# framework are two independent artefacts that must agree, and cargo can only
# police one of them. `cef 151.6.0+151.3.18` encodes the CEF build it was
# generated against in its BUILD METADATA — which cargo ignores in version
# requirements, so `=151.6.0` is the strongest thing a manifest can say. The
# framework itself arrives from a tarball cargo never sees when CEF_PATH is
# set (see THE FOOTGUN below). This file is the one place both numbers are
# written down, and scripts/mac-bundle.sh refuses to bundle when they differ.
#
# THE FOOTGUN, measured rather than assumed: cef-dll-sys's build script DOES
# check CEF_PATH against the crate version — and the check is ONE-SIDED. It
# reads `archive.json` next to the framework and accepts the directory if
#
#     archive_version <= crate_version        (download-cef-2.3.2 lib.rs:100)
#
# so a framework OLDER than the bindings passes in silence, and only a NEWER
# one is rejected. That is the wrong direction to be lenient in: the bindings
# describe structs the older framework has not got. The spike built
# `cef 151.7.0+151.3.23` against a downloaded 151.3.18 for its entire life and
# was never told; every number in the spike report was measured through that
# mismatch. It worked, which is the problem — it is the shape of bug that
# surfaces as an unexplained crash a quarter later.
#
# cef_check_pin below asserts EQUALITY, in both directions, which is the check
# the crate declines to make.

# MOVING THE PIN: change CEF_VERSION, CEF_CHROMIUM, CEF_CRATE, CEF_ARCHIVE and
# CEF_ARCHIVE_SHA1 together, run `cargo update -p cef -p cef-dll-sys --precise
# <crate>+<version>` in spike/cef-osr, delete $CEF_PATH, and let the build
# script re-download. Chromium ships security releases roughly monthly, so
# this moves whether or not we want it to.

# The CEF binary distribution.
#
# CODECS (Slice BR1): this SHA1 is the Spotify *public* minimal tarball
# (ffmpeg_branding=Chromium, proprietary_codecs=false). A self-build at
# the SAME CEF_VERSION / CEF_CRATE / CEF_CHROMIUM with
# proprietary_codecs=true ffmpeg_branding=Chrome replaces the SHA1, not
# the version — that is how pin equality keeps holding both directions.
# Script: scripts/cef-with-codecs/. Report: docs/reports/stage-br1-codecs.md.
# Do not bump CEF_VERSION to pick up codecs.
CEF_VERSION=151.3.18
CEF_CHROMIUM=151.0.7922.138

# The cef-rs crate version whose generated bindings match CEF_VERSION. Both
# `cef` and `cef-dll-sys` are pinned to it in spike/cef-osr/Cargo.lock.
CEF_CRATE=151.6.0

# `minimal` drops the debug symbols and the sample apps; it is already the
# small distribution (343 MB down, 317 MB in-bundle).
CEF_DISTRIBUTION=minimal

# Only the arm64 archive is pinned by hash, because that is the only one
# anything here has downloaded. cef_check_pin states this rather than passing
# silently on another arch — an unpinned hash is not the same as a match.
CEF_PLATFORM_arm64=macosarm64
CEF_ARCHIVE_arm64=cef_binary_151.3.18+gbeff58d+chromium-151.0.7922.138_macosarm64_minimal.tar.bz2
CEF_ARCHIVE_SHA1_arm64=8245a003c52c01811310b9b7d026e92dff859626
