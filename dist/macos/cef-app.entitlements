<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the MAIN bundle under a hardened runtime.

  We ship unsigned today, so nothing below is in force. It is written down
  because the hardened runtime is not optional for notarization, and every
  entry here was arrived at by watching CEF die without it (2026-08-21,
  scripts/verify-cef-bundle.sh's own evidence trail — see
  docs/reports/stage-c2-bundle.md §"what the hardened runtime costs").

  disable-library-validation is the one that is not negotiable and the one
  that surprises people. Library validation restricts dlopen to code signed
  by the SAME Team ID as the loading process. `Chromium Embedded Framework`
  ships adhoc-signed by the CEF project, so unless we re-sign 214 MB of
  Chromium with our own certificate on every build, the app and the framework
  have different team identities and dlopen refuses:

      code signature ... not valid for use in process:
      mapping process and mapped file (non-platform) have different Team IDs

  which is a hard failure before any of our code runs.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
